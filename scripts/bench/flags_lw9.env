# LW6t: LW6 full paths plus validated C24 Thompson column solver.
# Product configuration frozen before gpuwrf/JAX import.
# Source before importing gpuwrf/JAX. Cache/artifact paths belong to each arm.
export GPUWRF_DYN_FP32=1
export GPUWRF_NOAHMP_NATIVE_REAL=1
export GPUWRF_NOAHMP_ITERATION_BARRIER=1
# Native REAL land carry comes from the product Noah initializer.
export GPUWRF_DYN_ADVECTION_FP32=1
export GPUWRF_DYN_DIFFUSION_FP32=1
export GPUWRF_DYN_RK_FP32=1
export GPUWRF_EDMF_FUSED_PLUME=1
export GPUWRF_MYNN_FP32_PLUME=1
export GPUWRF_KF_RESIDENT_TABLES=1
export GPUWRF_MCICA_JUMPAHEAD=1
export GPUWRF_MCICA_LEGACY_FP64=0
export GPUWRF_RRTMG_LW_FUSED_TRANSFER=1
export GPUWRF_RRTMG_SW_FUSED_QUADRATURE=1
# BP32 same-input asserted-GPU gate passed (8 calls, 48 mean checks).
export GPUWRF_MYNN_FP32_COLUMNS=1
# Whole columns already includes the native BouLac kernel.
export GPUWRF_MYNN_FP32_BOULAC=0
export GPUWRF_MYNN_CLOUDMIX=1
# KF column is enabled after RF02; C24 native policy preserves declared DOUBLE islands.
export GPUWRF_KF_COLUMN_FP32=1
export GPUWRF_THOMPSON_FP32=0
export GPUWRF_THOMPSON_NATIVE_REAL=1
export GPUWRF_THOMPSON_FULL_COLUMN=1
export GPUWRF_THOMPSON_COLUMN_SED=1
export GPUWRF_THOMPSON_SED_FP32=1
export GPUWRF_THOMPSON_SED_PREP_FUSED=0
export GPUWRF_THOMPSON_COLUMN_LAYOUT=1
# Keep WRF DOUBLE islands and the retained interfaces; this acoustic flag is
# not a claim that all remaining model arithmetic/carry is already fp32.
export JAX_ENABLE_X64=true
export JAX_PALLAS_USE_MOSAIC_GPU=false
# Timing/fidelity arms use census=0; a separate counts arm may override to 1.
export GPUWRF_CENSUS="${GPUWRF_CENSUS:-0}"
# Device-resident conditional bands prevent scalar host reads in radiation.
export XLA_FLAGS="${XLA_FLAGS:+${XLA_FLAGS} }--xla_gpu_enable_command_buffer=+CONDITIONAL --xla_enable_command_buffers_during_profiling=true"
# Normal autotuning: main's limiter barrier fixes B23; no autotune_level=0.
# Update held flags only after the manager records the required lane gates.

export GPUWRF_THOMPSON_FULL_COLUMN_EARLY_EXIT=1

export GPUWRF_THOMPSON_IMPLICIT_SED=0

# LW9 additions (merged + GPU-gated; integrate flag rule)
export GPUWRF_BOUNDARY_FP32=1
export GPUWRF_NOAHMP_LAYER_SELECT=1
export GPUWRF_RRTMG_COLUMN_TILE_COLS=4096
export GPUWRF_GWDO_NATIVE_REAL=1
export GPUWRF_DYN_CARRY_FP32=1
export GPUWRF_DYN_PD_FP32=1
export GPUWRF_ACOUSTIC_ALIAS=1
export GPUWRF_SFCLAY_NATIVE_REAL=1
export GPUWRF_HISTORY_INSTEP_DIAG=1
